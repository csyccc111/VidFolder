{
  "name": "vid-folder-browser",
  "version": "0.8.1",
  "private": true,
  "description": "A lightweight desktop video folder browser with cached thumbnails.",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron.cjs",
    "postinstall": "node scripts/ensure-electron.cjs",
    "predev": "node scripts/ensure-electron.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 dist-electron/electron/main.js && electron .\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "predist:zip": "node scripts/ensure-electron.cjs",
    "dist:zip": "npm run build && electron-builder --win zip",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json --noEmit"
  },
  "build": {
    "appId": "com.vidfolder.browser",
    "productName": "Vid Folder Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Vid.Folder.Browser-${version}-win-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.1.2",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.31",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.6",
    "electron": "^36.4.0",
    "electron-builder": "^26.15.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
